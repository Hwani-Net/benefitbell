rules_version = '2';

// 혜택알리미 Firestore 보안 규칙
// 모든 Firestore 접근은 서버 API 라우트(Firebase Admin SDK)를 경유함.
// Admin SDK는 이 규칙을 우회하므로, 클라이언트 직접 접근만 차단.
// (서버 API는 /api/user/profile 등에서 Firebase idToken Bearer 검증 수행)

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
